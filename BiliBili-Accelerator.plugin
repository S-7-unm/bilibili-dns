#!name=B站加速 · BiliBili Accelerator
#!desc=视频 CDN 分流为主，附带播放接口换线路（MitM 增强项）；线路清单由 GitHub Actions 每日从上游仓库同步
#!author=Qwen Go
#!homepage=https://github.com/realzza/bilibili-accelerator
#!icon=https://www.bilibili.com/favicon.ico
#!system=iOS,iPadOS,tvOS,macOS
#!loon_version=3.5.1(983)
#!date=2026-11-22
#!tag=B站,视频,加速

# 说明：本插件刻意不写 #!source，避免锁定单个下载地址导致自动更新时校验失败。

[Argument]
rewrite_enabled = switch,true,type=boolean,tag=启用换线路,desc=播放接口改写总开关（依赖 MitM 与证书，未装证书时保持关闭即可）
rewrite_mode = select,"backup","probe","fixed","off",type=string,tag=换线路模式,desc=backup=改用接口自带备用线路；probe=按探测结果择优；fixed=固定用下面的 host；off=只分流不改写
prefer_host = input,type=string,tag=固定线路 host,desc=换线路模式选 fixed 时填写，例如 upos-sz-mirrorali.bilivideo.com
probe_enabled = switch,false,type=boolean,tag=启用定时探测,desc=会按周期向 CDN 发少量测速请求，不需要可关
probe_cron = input,"0 */4 * * *",type=string,tag=探测周期,desc=Cron 表达式，默认每 4 小时
ruleset_url = input,"https://cdn.jsdelivr.net/gh/CHANGE_ME_OWNER/CHANGE_ME_REPO@main/build/cdn-hosts.json",type=string,tag=线路清单地址,desc=指向本仓库 build/cdn-hosts.json；留空则只用内置白名单
probe_node = input,type=string,tag=探测指定策略,desc=留空跟随当前路由，可填策略组名或节点名
probe_notify = switch,false,type=boolean,tag=探测结果通知,desc=线路发生变化时推送一次
rewrite_debug = switch,false,type=boolean,tag=改写调试日志
probe_debug = switch,false,type=boolean,tag=探测调试日志

[General]
# fake-ip 模式下让播放域名拿到真实 IP，避免 CDN 按虚拟 IP 调度导致绕路。
real-ip = *.bilivideo.com,*.bilivideo.cn,*.bilivideo.net,*.acgvideo.com

[Rule]
# ===== 视频与直播 CDN 交给 PROXY（在 Loon 里把 PROXY 指向你的国内落地节点）=====
DOMAIN-SUFFIX,bilivideo.com,PROXY
DOMAIN-SUFFIX,bilivideo.cn,PROXY
DOMAIN-SUFFIX,bilivideo.net,PROXY
DOMAIN-SUFFIX,acgvideo.com,PROXY
DOMAIN-SUFFIX,ourdvsss.com,PROXY
DOMAIN-SUFFIX,ksyungslb.com,PROXY
DOMAIN-SUFFIX,smtcdns.net,PROXY
DOMAIN-SUFFIX,mincdn.com,PROXY
DOMAIN-SUFFIX,maoercdn.com,PROXY
DOMAIN-SUFFIX,bilicdn1.com,PROXY
DOMAIN-SUFFIX,bilicdn2.com,PROXY
DOMAIN-SUFFIX,bilicdn3.com,PROXY
DOMAIN-SUFFIX,bilicdn4.com,PROXY
DOMAIN-SUFFIX,bilicdn5.com,PROXY
DOMAIN-SUFFIX,uposdash-302-bilivideo.yfcdn.net,PROXY
DOMAIN,upos-hz-mirrorakam.akamaized.net,PROXY
DOMAIN,upos-bstar-mirrorakam.akamaized.net,PROXY
DOMAIN,upos-bstar1-mirrorakam.akamaized.net,PROXY

# ===== 页面、接口与静态资源保持原样，避免影响登录 / 弹幕 / 推荐流 =====
DOMAIN-SUFFIX,hdslb.com,DIRECT
DOMAIN-SUFFIX,hdslb.net,DIRECT
DOMAIN-SUFFIX,bilibili.com,DIRECT
DOMAIN-SUFFIX,bilibili.cn,DIRECT
DOMAIN-SUFFIX,bilibili.co,DIRECT
DOMAIN-SUFFIX,biliapi.com,DIRECT
DOMAIN-SUFFIX,biliapi.net,DIRECT
DOMAIN-SUFFIX,acg.tv,DIRECT
DOMAIN-SUFFIX,b23.tv,DIRECT
DOMAIN-SUFFIX,biligo.com,DIRECT
DOMAIN-SUFFIX,im9.com,DIRECT

# ===== 需要整站回国（含版权判定、弹幕、大会员）时，取消下面两行注释并删掉上面的 DIRECT 段 =====
# DOMAIN-SUFFIX,bilibili.com,PROXY
# DOMAIN-SUFFIX,biliapi.net,PROXY

[Script]
response if (${url} ~= /^https:\/\/(api\.bilibili\.com|app\.bilibili\.com|api\.live\.bilibili\.com|app\.biliapi\.net|live\.biliapi\.net)\/(x\/player\/(wbi\/)?playurl|pgc\/player\/(web|api)\/playurl|x\/v2\/view|room\/v1\/Room\/playUrl|xlive\/web-room\/v1\/index\/getRoomPlayInfo)/i && ${response.header['Content-Type']} ~= /application\/json/i) then script("https://cdn.jsdelivr.net/gh/CHANGE_ME_OWNER/CHANGE_ME_REPO@main/Scripts/bili-playurl-rewrite.js", {${rewrite_mode}, ${prefer_host}, ${rewrite_debug}}) with enable=${rewrite_enabled}, requires_body=true, timeout=20, tag="B站播放线路改写"
cron ${probe_cron} then script("https://cdn.jsdelivr.net/gh/CHANGE_ME_OWNER/CHANGE_ME_REPO@main/Scripts/bili-line-probe.js", {${ruleset_url}, ${probe_node}, ${probe_notify}, ${probe_debug}}) with enable=${probe_enabled}, timeout=120, tag="B站线路探测"

[Mitm]
hostname = api.bilibili.com,app.bilibili.com,api.live.bilibili.com,app.biliapi.net,live.biliapi.net
